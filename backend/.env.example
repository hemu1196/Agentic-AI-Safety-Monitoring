# ================================================================
# AI-Powered Construction Safety & Risk Intelligence Platform
# Environment Configuration Template
# ================================================================

# Application
PROJECT_NAME="AI-Powered Construction Safety & Risk Intelligence Platform"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api"

# Security (Generate a strong random secret key for production)
JWT_SECRET_KEY="replace_with_a_secure_random_secret_key_at_least_32_chars_long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=construction_safety_db
POSTGRES_PORT=5432

# Or specify a complete SQLAlchemy database URI directly:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/construction_safety_db
# For lightweight local testing without PostgreSQL, SQLite can also be used:
# DATABASE_URL=sqlite:///./construction_safety.db

# CORS Allowed Origins (Comma-separated list or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# File Storage
UPLOAD_DIR="uploads"
